{
  "name": "landing-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "standalone": "node .next/standalone/server.js",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "generate:importmap": "payload generate:importmap",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "knip": "node --import tsx ./node_modules/knip/bin/knip.js",
    "generate": "payload generate:types"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@c15t/nextjs": "^2.1.0",
    "@c15t/scripts": "^2.1.0",
    "@code0-tech/pictor": "^0.9.1",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/email-nodemailer": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/plugin-import-export": "3.85.1",
    "@payloadcms/plugin-seo": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@tabler/icons-react": "3.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "knip": "^6.15.0",
    "motion": "^12.40.0",
    "next": "^16.2.7",
    "next-sitemap": "^4.2.3",
    "ogl": "^1.0.11",
    "payload": "3.85.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "14.0.0",
    "nodemailer": "8.0.10",
    "lodash": "4.18.1",
    "file-type": "22.0.0",
    "undici": "8.4.1",
    "dompurify": "3.4.8",
    "yaml": "2.9.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.0"
    }
  }
}
