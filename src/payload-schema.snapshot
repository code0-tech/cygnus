      columns: [columns['_parentID']],
      foreignColumns: [licenses.id],
      name: 'licenses_locales_parent_id_fk'
    }).onDelete('cascade'),
]
)


export const errors = pgTable('errors', {
  id: serial('id').primaryKey(),
  updatedAt: timestamp('updated_at', {mode: 'string',withTimezone: true,precision: 3}),
  createdAt: timestamp('created_at', {mode: 'string',withTimezone: true,precision: 3}),
}
)


export const errors_locales = pgTable('errors_locales', {
  dashboardLoad: varchar('dashboard_load').notNull(),
  retry: varchar('retry').notNull(),
  customerUpdate: varchar('customer_update').notNull(),
  paymentMethodUpdate: varchar('payment_method_update').notNull(),
  licenseUpdate: varchar('license_update').notNull(),
  subscriptionPreview: varchar('subscription_preview').notNull(),
  billingUpdate: varchar('billing_update').notNull(),
  subscriptionCancel: varchar('subscription_cancel').notNull(),
  subscriptionResume: varchar('subscription_resume').notNull(),
  planUpgrade: varchar('plan_upgrade').notNull(),
  paymentFallback: varchar('payment_fallback').notNull(),
  sessionUnavailable: varchar('session_unavailable').notNull(),
  customerCreation: varchar('customer_creation').notNull(),
  customerTypeMismatch: varchar('customer_type_mismatch').notNull(),
  checkoutCustomer: varchar('checkout_customer').notNull(),
  checkoutSession: varchar('checkout_session').notNull(),
  checkoutSessionExpired: varchar('checkout_session_expired').notNull(),
  billingAddressUpdate: varchar('billing_address_update').notNull(),
  emailUpdate: varchar('email_update').notNull(),
  taxIdUpdate: varchar('tax_id_update').notNull(),
  taxIdIncomplete: varchar('tax_id_incomplete').notNull(),
  paymentConfirmation: varchar('payment_confirmation').notNull(),
  discountSessionRequired: varchar('discount_session_required').notNull(),
  discountValidation: varchar('discount_validation').notNull(),
  checkoutLicenseStatus: varchar('checkout_license_status').notNull(),
  id: serial('id').primaryKey(),
  _locale: enum__locales('_locale').notNull(),
  _parentID: integer('_parent_id').notNull(),
}, (columns) => [
    uniqueIndex('errors_locales_locale_parent_id_unique').on(columns._locale, columns._parentID), foreignKey({
      columns: [columns['_parentID']],
      foreignColumns: [errors.id],
      name: 'errors_locales_parent_id_fk'
    }).onDelete('cascade'),
]
)

